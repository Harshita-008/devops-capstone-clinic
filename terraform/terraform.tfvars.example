# Copy to terraform.tfvars to override defaults. terraform.tfvars is gitignored.
# AWS credentials never go here: they come from `aws configure` or environment variables.

aws_region         = "ap-south-1"
project_name       = "clinicflow"
environment        = "dev"
vpc_cidr           = "10.30.0.0/16"
az_count           = 2
kubernetes_version = "1.35"
node_instance_type = "t3.small"

node_count = {
  desired = 1
  min     = 1
  max     = 2
}
